# ProjectAcademy — variables du projet Vercel FRONTEND
# Vercel > Project Settings > Environment Variables
# Seules les variables NEXT_PUBLIC_* sont intégrées au navigateur.
# Ne jamais mettre de mot de passe ou de clé privée dans ce fichier.

NEXT_PUBLIC_API_URL=https://projectacademy-api.vercel.app/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
