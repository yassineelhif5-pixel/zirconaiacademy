# ProjectAcademy — variables du projet Vercel BACKEND
# Vercel > Project Settings > Environment Variables
# Ne remplacez jamais ces exemples par de vrais secrets dans GitHub.

# Environnement Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=GENERATE_A_SECURE_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=projectacademy-api.vercel.app,.vercel.app
SECURE_SSL_REDIRECT=True

# Supabase PostgreSQL — utiliser Connect > Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres
DB_POOLER_MODE=transaction

# CORS — domaine public du frontend uniquement
CORS_ALLOWED_ORIGINS=https://projectacademy.zirconai.fr

# Google OAuth — identifiant client Web (non secret, mais doit correspondre au frontend)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# Email transactionnel — facultatif jusqu'à activation des notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_SMTP_USERNAME
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=ProjectAcademy <no-reply@zirconai.fr>

# Assistant IA — facultatif, garder vide tant que non configuré
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Paramètre Vercel
DB_POOLER_MODE=transaction
